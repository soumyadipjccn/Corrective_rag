# ==============================================================================
# Corrective RAG (CRAG) Environment Configuration
# ==============================================================================

# NVIDIA NIM API Keys
# You can use a single shared NVIDIA_API_KEY for both, OR specify separate keys below:
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
# Optional separate keys (uncomment to override):
# NVIDIA_CHAT_API_KEY=nvapi-chat-key-here
# NVIDIA_EMBEDDING_API_KEY=nvapi-embed-key-here

# Voyage AI API Key (Optional / Alternative Embedding Provider)
VOYAGE_API_KEY=pa-your-voyage-api-key-here

# Tavily API Key (Required for corrective web search fallback)
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rag-qdrant

# Model Configuration
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Chunking & Splitting Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# LLM Generation Parameters
TEMPERATURE=0.0
MAX_TOKENS=1000
